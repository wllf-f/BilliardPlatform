.address-page {
  padding-bottom: 20rpx;
}

.confirm-card {
  background: linear-gradient(135deg, #1a6b3c, #2d8f5a);
  color: #fff;
}

.confirm-title {
  font-size: 32rpx;
  font-weight: bold;
}

.confirm-price {
  font-size: 28rpx;
  margin-top: 10rpx;
  opacity: 0.9;
}

.confirm-product {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.confirm-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.confirm-product-info {
  flex: 1;
}

.confirm-product-name {
  font-size: 26rpx;
}

.confirm-product-info .price {
  font-size: 26rpx;
  margin-top: 6rpx;
  color: #fff;
}

.addr-list {
  padding: 16rpx 24rpx;
}

.addr-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.addr-item-top {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.addr-item-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-right: 24rpx;
}

.addr-item-phone {
  font-size: 28rpx;
  color: #666;
}

.default-tag {
  background: #1a6b3c;
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  margin-left: 16rpx;
}

.addr-item-detail {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

.addr-item-ops {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
}

.op-btn {
  font-size: 24rpx;
  color: #666;
  padding: 8rpx 20rpx;
  margin-left: 20rpx;
}

.op-btn.edit {
  color: #1a6b3c;
}

.op-btn.delete {
  color: #e4393c;
}

.select-btn {
  font-size: 24rpx;
  color: #fff;
  background: #1a6b3c;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  margin-right: auto;
}

.quantity-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.quantity-label {
  font-size: 28rpx;
  color: #666;
}

.quantity-control {
  display: flex;
  align-items: center;
}

.qty-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 36rpx;
}

.qty-num {
  width: 80rpx;
  text-align: center;
  font-size: 30rpx;
}

.remark-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.remark-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #666;
}

.remark-input {
  flex: 1;
  font-size: 28rpx;
}

.total-row {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding-top: 20rpx;
  font-size: 30rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
}

.bar-submit {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #1a6b3c, #2d8f5a);
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
}

/* 弹窗 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.form-panel {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 30rpx;
  box-sizing: border-box;
  max-height: 90vh;
  overflow-y: auto;
}

.form-title {
  font-size: 34rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 30rpx;
}

.form-input-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-input-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #666;
}

.form-input-box {
  flex: 1;
  height: 60rpx;
  font-size: 28rpx;
}

.default-row {
  justify-content: space-between;
}

.form-btns {
  display: flex;
  margin-top: 40rpx;
}

.form-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  font-size: 30rpx;
  margin: 0 10rpx;
}

.form-btn.cancel {
  background: #f5f5f5;
  color: #666;
}

.form-btn.confirm {
  background: #1a6b3c;
  color: #fff;
}

/* 省市区选择器样式 */
.form-input-clickable {
  cursor: pointer;
}

.region-text {
  color: #333;
}

.placeholder-text {
  color: #999;
}

.region-arrow {
  color: #ccc;
  font-size: 36rpx;
  margin-left: 8rpx;
  line-height: 1;
}

/* 空状态样式 */
.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: #bbb;
  margin-bottom: 40rpx;
}

.empty-btn {
  background: linear-gradient(135deg, #1a6b3c, #2d8f5a);
  color: #fff;
  font-size: 30rpx;
  padding: 24rpx 60rpx;
  border-radius: 44rpx;
  box-shadow: 0 8rpx 24rpx rgba(26, 107, 60, 0.3);
}
