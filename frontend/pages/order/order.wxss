.order-page {
  padding-bottom: 20rpx;
}

.addr-card {
  display: flex;
  align-items: center;
  position: relative;
  overflow: hidden;
}

.addr-card::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: repeating-linear-gradient(90deg, #1a6b3c 0, #1a6b3c 20rpx, transparent 20rpx, transparent 40rpx);
}

.addr-info {
  flex: 1;
  min-width: 0;
}

.addr-name {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.addr-consignee {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-right: 30rpx;
}

.addr-phone {
  font-size: 28rpx;
  color: #666;
}

.addr-detail {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

.addr-empty {
  flex: 1;
}

.addr-empty-text {
  color: #999;
  font-size: 30rpx;
}

.addr-arrow {
  color: #ccc;
  font-size: 36rpx;
  margin-left: 20rpx;
}

.product-row {
  display: flex;
}

.product-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.product-name {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
}

.product-tags {
  margin: 10rpx 0;
}

.price-line {
  font-size: 30rpx;
}

.quantity-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f5f5f5;
}

.quantity-label {
  font-size: 28rpx;
  color: #666;
}

.quantity-control {
  display: flex;
  align-items: center;
}

.qty-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 36rpx;
  color: #333;
}

.qty-num {
  width: 80rpx;
  text-align: center;
  font-size: 30rpx;
}

.remark-row {
  display: flex;
  align-items: center;
}

.remark-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #666;
}

.remark-input {
  flex: 1;
  font-size: 28rpx;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 28rpx;
  color: #666;
}

.total-price {
  font-size: 34rpx;
  font-weight: bold;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
}

.bar-total {
  font-size: 30rpx;
  color: #333;
}

.bar-submit {
  background: linear-gradient(135deg, #1a6b3c, #2d8f5a);
  color: #fff;
  border-radius: 44rpx;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 60rpx;
  font-size: 32rpx;
  font-weight: 500;
}
