.detail-page {
  padding-bottom: 20rpx;
}

.banner {
  width: 100%;
  height: 600rpx;
  background: #fff;
}

.banner-img {
  width: 100%;
  height: 600rpx;
}

.price-card {
  background: #fff;
  padding: 24rpx;
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.platform-price {
  color: #e4393c;
}

.price-symbol {
  font-size: 28rpx;
}

.price-num {
  font-size: 56rpx;
  font-weight: bold;
}

.other-price {
  display: flex;
  flex-direction: column;
  font-size: 22rpx;
  color: #999;
  text-align: right;
}

.other-price text {
  text-decoration: line-through;
  margin-bottom: 6rpx;
}

.sales-row {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999;
}

.title-card {
  background: #fff;
  padding: 24rpx;
  margin-top: 16rpx;
}

.title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.5;
}

.tags {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
}

.tags .tag {
  margin-bottom: 10rpx;
  background: #f5f5f5;
  color: #666;
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #1a6b3c;
}

.param-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 28rpx;
}

.param-label {
  color: #999;
}

.param-value {
  color: #333;
}

.desc {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
}

.detail-img {
  width: 100%;
  display: block;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
}

.bar-icon {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  margin: 0 10rpx;
}

.bar-icon-text {
  font-size: 40rpx;
}

.bar-text {
  font-size: 20rpx;
  color: #666;
}

.bar-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  font-size: 32rpx;
  font-weight: 500;
  margin-left: 20rpx;
}

.buy-btn {
  background: linear-gradient(135deg, #1a6b3c, #2d8f5a);
  color: #fff;
}
