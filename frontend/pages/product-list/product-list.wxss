.product-list-page {
  padding-bottom: 30rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 10;
}

.search-input {
  flex: 1;
  background: #f5f5f5;
  border-radius: 32rpx;
  padding: 14rpx 28rpx;
  font-size: 28rpx;
}

.search-btn {
  margin-left: 20rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.filter-bar {
  display: flex;
  background: #fff;
  padding: 20rpx 0;
  position: sticky;
  top: 88rpx;
  z-index: 9;
  border-bottom: 1rpx solid #f0f0f0;
}

.filter-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #666;
  position: relative;
}

.filter-item.active {
  color: #1a6b3c;
  font-weight: bold;
}

.filter-more {
  color: #1a6b3c;
}

.list {
  padding: 16rpx 16rpx 0;
}

.product-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.product-img {
  width: 240rpx;
  height: 240rpx;
  background: #f5f5f5;
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.product-name {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
}

.product-tags {
  margin: 10rpx 0;
}

.product-brand {
  font-size: 22rpx;
  color: #999;
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: 10rpx;
}

.price-box {
  display: flex;
  flex-direction: column;
}

.official-price {
  font-size: 20rpx;
  color: #bbb;
  text-decoration: line-through;
  margin-top: 4rpx;
}

.sales-text {
  font-size: 22rpx;
  color: #999;
}

/* 筛选弹窗 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  justify-content: flex-end;
}

.filter-panel {
  width: 80%;
  height: 100%;
  background: #fff;
  padding: 40rpx 30rpx;
  box-sizing: border-box;
  overflow-y: auto;
}

.filter-title {
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  text-align: center;
}

.filter-group {
  margin-bottom: 40rpx;
}

.filter-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.filter-opts {
  display: flex;
  flex-wrap: wrap;
}

.opt {
  padding: 14rpx 30rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666;
  margin: 0 16rpx 16rpx 0;
}

.opt.active {
  background: #1a6b3c;
  color: #fff;
}

.price-inputs {
  display: flex;
  align-items: center;
}

.price-input {
  flex: 1;
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
}

.price-line {
  margin: 0 20rpx;
  color: #999;
}

.filter-btns {
  display: flex;
  margin-top: 60rpx;
}

.filter-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  font-size: 30rpx;
  margin: 0 10rpx;
}

.filter-btn.reset {
  background: #f5f5f5;
  color: #666;
}

.filter-btn.confirm {
  background: #1a6b3c;
  color: #fff;
}

/* 选择模式样式 */
.card-select {
  border: 2rpx solid #1a6b3c;
  display: flex;
  align-items: stretch;
}

.card-body {
  flex: 1;
  display: flex;
  min-width: 0;
}

.select-btn-wrap {
  width: 100rpx;
  min-height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1a6b3c;
  color: #fff;
  font-size: 28rpx;
  border-radius: 0 16rpx 16rpx 0;
  flex-shrink: 0;
}
