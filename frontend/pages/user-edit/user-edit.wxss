.user-edit-page {
  padding: 20rpx 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* 头像区域 */
.avatar-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 24rpx;
}

.avatar-wrap {
  display: flex;
  align-items: center;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #f5f5f5;
}

.arrow {
  font-size: 28rpx;
  color: #ccc;
  margin-left: 16rpx;
}

/* 信息区域 */
.info-section {
  padding: 0 24rpx;
}

.info-row {
  display: flex;
  align-items: center;
  height: 100rpx;
}

.label {
  font-size: 30rpx;
  color: #333;
  width: 140rpx;
  flex-shrink: 0;
}

.info-input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  text-align: right;
}

/* 保存按钮 */
.save-btn {
  position: fixed;
  bottom: 40rpx;
  left: 24rpx;
  right: 24rpx;
  height: 90rpx;
  line-height: 90rpx;
  text-align: center;
  background: linear-gradient(135deg, #1a6b3c, #2d8f5a);
  color: #fff;
  font-size: 32rpx;
  border-radius: 45rpx;
  box-shadow: 0 8rpx 24rpx rgba(26, 107, 60, 0.3);
}

.save-btn:active {
  opacity: 0.85;
}
