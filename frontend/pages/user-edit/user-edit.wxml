<view class="user-edit-page">
  <!-- 头像 -->
  <view class="card avatar-section" bindtap="changeAvatar">
    <text class="label">头像</text>
    <view class="avatar-wrap">
      <image class="avatar" src="{{userInfo.avatar || '/images/default-avatar.png'}}" mode="aspectFill"></image>
      <text class="arrow">></text>
    </view>
  </view>

  <!-- 昵称 -->
  <view class="card info-section">
    <view class="info-row">
      <text class="label">昵称</text>
      <input class="info-input" placeholder="请输入昵称" value="{{nickname}}" bindinput="onNicknameInput" />
    </view>
  </view>

  <!-- 手机号 -->
  <view class="card info-section">
    <view class="info-row">
      <text class="label">手机号</text>
      <input class="info-input" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhoneInput" />
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="save-btn" bindtap="save">保存修改</view>
</view>
