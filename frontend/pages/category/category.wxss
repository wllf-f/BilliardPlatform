.category-page {
  height: 100vh;
}

.cat-layout {
  display: flex;
  height: 100vh;
}

.left-scroll {
  width: 200rpx;
  height: 100%;
  background: #f0f0f0;
}

.left-item {
  position: relative;
  padding: 36rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #666;
}

.left-item.active {
  background: #fff;
  color: #1a6b3c;
  font-weight: bold;
}

.left-bar {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 40rpx;
  background: #1a6b3c;
  border-radius: 0 4rpx 4rpx 0;
}

.right-scroll {
  flex: 1;
  height: 100%;
  padding: 20rpx;
}

.brand-section {
  margin-bottom: 20rpx;
}

.brand-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin: 10rpx 0 20rpx;
}

.brand-grid {
  display: flex;
  flex-wrap: wrap;
}

.brand-item {
  width: 33.33%;
  padding: 8rpx;
  box-sizing: border-box;
}

.brand-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 30rpx 10rpx;
  text-align: center;
  font-size: 24rpx;
  color: #333;
  border: 2rpx solid #eee;
  height: 90rpx;
  line-height: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.brand-card.all {
  background: #1a6b3c;
  color: #fff;
  border-color: #1a6b3c;
}

.entry-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 30rpx 24rpx;
  margin-top: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.entry-text {
  font-size: 28rpx;
  color: #1a6b3c;
  font-weight: 500;
}

.entry-arrow {
  color: #ccc;
  font-size: 32rpx;
}

.empty-text {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 40rpx 0;
}
