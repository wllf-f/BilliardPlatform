.order-detail-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

.status-card {
  background: #fff;
  margin: 20rpx;
  padding: 30rpx;
  border-radius: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.status-info {
  display: flex;
  flex-direction: column;
}

.status-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.order-no {
  font-size: 24rpx;
  color: #999;
}

.card {
  background: #fff;
  margin: 20rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #eee;
}

.address-content {
  display: flex;
  align-items: flex-start;
}

.address-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.address-info {
  flex: 1;
}

.address-top {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.consignee {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-right: 20rpx;
}

.phone {
  font-size: 28rpx;
  color: #666;
}

.address-detail {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
}

.logistics-content {
  padding: 10rpx 0;
}

.logistics-row {
  display: flex;
  align-items: flex-start;
}

.logistics-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.logistics-info {
  flex: 1;
}

.logistics-company {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.logistics-no {
  font-size: 28rpx;
  color: #666;
}

.goods-list {
  padding-bottom: 10rpx;
}

.goods-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.goods-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
}

.goods-info {
  flex: 1;
  margin-left: 20rpx;
}

.goods-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.goods-spec {
  font-size: 24rpx;
  color: #999;
}

.goods-subtotal {
  font-size: 30rpx;
  font-weight: bold;
  color: #e53935;
}

.custom-form {
  padding: 10rpx 0;
}

.custom-section {
  margin-bottom: 24rpx;
}

.custom-section:last-child {
  margin-bottom: 0;
}

.section-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #1a6b3c;
  margin-bottom: 16rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #1a6b3c;
}

.custom-row {
  display: flex;
  padding: 10rpx 0;
  font-size: 26rpx;
  color: #666;
}

.custom-label {
  width: 180rpx;
  color: #999;
  flex-shrink: 0;
}

.info-list {
  padding: 10rpx 0;
}

.info-row {
  display: flex;
  padding: 16rpx 0;
  font-size: 28rpx;
}

.info-label {
  width: 180rpx;
  color: #999;
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  color: #333;
}

.amount-card {
  padding: 24rpx;
}

.amount-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  font-size: 28rpx;
}

.amount-label {
  color: #666;
}

.amount-value {
  color: #333;
}

.amount-row.total {
  border-top: 1rpx solid #eee;
  margin-top: 12rpx;
  padding-top: 20rpx;
}

.amount-row.total .amount-label {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.amount-row.total .amount-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #e53935;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: flex-end;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.action-btn {
  padding: 20rpx 40rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  margin-left: 20rpx;
}

.action-btn.cancel {
  background: #f5f5f5;
  color: #666;
}

.action-btn.pay {
  background: #e53935;
  color: #fff;
}

.action-btn.confirm {
  background: #1a6b3c;
  color: #fff;
}

.type-tag {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.tag-normal {
  background: #e8f5ee;
  color: #1a6b3c;
}

.tag-custom {
  background: #fff3e0;
  color: #e65100;
}

.tag-tip {
  background: #f3e5f5;
  color: #7b1fa2;
}

.countdown-tip {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 16rpx 24rpx;
  background: #fff8e1;
  border-radius: 12rpx;
}

.countdown-label {
  font-size: 26rpx;
  color: #f57c00;
}

.countdown-time {
  font-size: 30rpx;
  font-weight: bold;
  color: #e53935;
  margin-left: 10rpx;
}