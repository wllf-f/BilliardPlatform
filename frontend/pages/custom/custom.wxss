.custom-page {
  padding-bottom: 30rpx;
}

.banner-card {
  background: linear-gradient(135deg, #1a6b3c, #2d8f5a);
  padding: 50rpx 40rpx;
  color: #fff;
}

.banner-title {
  font-size: 44rpx;
  font-weight: bold;
}

.banner-desc {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 12rpx;
}

.banner-price {
  font-size: 36rpx;
  font-weight: bold;
  margin-top: 20rpx;
}

.section {
  margin: 20rpx 24rpx;
  padding: 30rpx 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1a6b3c;
  margin-bottom: 24rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #1a6b3c;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.textarea-row {
  flex-direction: column;
  align-items: flex-start;
}

.form-label {
  width: 200rpx;
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
}

.textarea-row .form-label {
  width: 100%;
  margin-bottom: 16rpx;
}

.form-input {
  flex: 1;
  height: 60rpx;
  font-size: 28rpx;
  color: #333;
}

.form-textarea {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  color: #333;
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
}

.bar-contact {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 140rpx;
  margin-right: 20rpx;
}

.bar-contact-icon {
  font-size: 40rpx;
}

.bar-contact-text {
  font-size: 20rpx;
  color: #666;
  margin-top: 4rpx;
}

.bar-submit {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #1a6b3c, #2d8f5a);
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
}

.agreement-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.agreement-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.agreement-desc {
  font-size: 26rpx;
  color: #888;
  line-height: 1.6;
}
