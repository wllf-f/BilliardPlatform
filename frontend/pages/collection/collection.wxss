.collection-page {
  padding: 16rpx 24rpx;
}

.collect-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.collect-img {
  width: 200rpx;
  height: 200rpx;
  background: #f5f5f5;
  flex-shrink: 0;
}

.collect-info {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.collect-name {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
}

.collect-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.cancel-btn {
  font-size: 24rpx;
  color: #e4393c;
  border: 2rpx solid #e4393c;
  border-radius: 24rpx;
  padding: 6rpx 20rpx;
}
