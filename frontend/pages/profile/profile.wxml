<view class="profile-page">
  <!-- 用户信息头部 -->
  <view class="header">
    <view class="user-info" bindtap="{{isLogin ? 'goEdit' : 'goLogin'}}">
      <image class="avatar" src="{{userInfo.avatar || '/images/default-avatar.png'}}" mode="aspectFill"></image>
      <view class="user-text">
        <view class="nickname">{{isLogin ? (userInfo.nickname || '未设置昵称') : '点击登录'}}</view>
        <view class="sub-text" wx:if="{{isLogin}}">{{userInfo.phone || '未绑定手机'}}</view>
        <view class="sub-text" wx:else>登录后享受更多服务</view>
      </view>
    </view>
  </view>

  <!-- 订单入口 -->
  <view class="card">
    <view class="card-header">
      <text class="card-title">我的订单</text>
      <text class="card-more" bindtap="goOrderList">查看全部 ></text>
    </view>
    <view class="order-entry">
      <view class="order-item" bindtap="goOrderListByStatus" data-status="1">
        <view class="order-icon">💰</view>
        <text class="order-text">待付款</text>
      </view>
      <view class="order-item" bindtap="goOrderListByStatus" data-status="2">
        <view class="order-icon">📦</view>
        <text class="order-text">待收货</text>
      </view>
      <view class="order-item" bindtap="goOrderListByStatus" data-status="3">
        <view class="order-icon">✅</view>
        <text class="order-text">已完成</text>
      </view>
    </view>
  </view>

  <!-- 功能列表 -->
  <view class="card menu-card">
    <view class="menu-item" bindtap="goCollection">
      <text class="menu-icon">❤️</text>
      <text class="menu-text">我的收藏</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goMyPost">
      <text class="menu-icon">📝</text>
      <text class="menu-text">我的发布</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goAddress">
      <text class="menu-icon">📍</text>
      <text class="menu-text">收货地址</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goCustom">
      <text class="menu-icon">✨</text>
      <text class="menu-text">仁杆定制</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goTipModify">
      <text class="menu-icon">🔧</text>
      <text class="menu-text">皮头改装</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goRecommend">
      <text class="menu-icon">🎯</text>
      <text class="menu-text">智能推荐</text>
      <text class="menu-arrow">></text>
    </view>
  </view>

  <!-- 其他 -->
  <view class="card menu-card">
    <view class="menu-item" bindtap="contactService">
      <text class="menu-icon">💬</text>
      <text class="menu-text">联系客服</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="aboutUs">
      <text class="menu-icon">ℹ️</text>
      <text class="menu-text">关于我们</text>
      <text class="menu-arrow">></text>
    </view>
    <view wx:if="{{isLogin}}" class="menu-item" bindtap="logout">
      <text class="menu-icon">🚪</text>
      <text class="menu-text">退出登录</text>
      <text class="menu-arrow">></text>
    </view>
  </view>
</view>
