<view class="home">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input" bindtap="goSearch">
      <text class="search-icon">🔍</text>
      <text class="search-placeholder">搜索球杆、皮头、配件...</text>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="nav-grid card">
    <view class="nav-item" bindtap="goCategory">
      <view class="nav-icon">🎱</view>
      <text class="nav-text">球杆分类</text>
    </view>
    <view class="nav-item" bindtap="goCompare">
      <view class="nav-icon">💰</view>
      <text class="nav-text">价格对比</text>
    </view>
    <view class="nav-item" bindtap="goRecommend">
      <view class="nav-icon">🎯</view>
      <text class="nav-text">智能推荐</text>
    </view>
    <view class="nav-item" bindtap="goCustom">
      <view class="nav-icon">✨</view>
      <text class="nav-text">仁杆定制</text>
    </view>
    <view class="nav-item" bindtap="goTipModify">
      <view class="nav-icon">🔧</view>
      <text class="nav-text">皮头改装</text>
    </view>
    <view class="nav-item" bindtap="goPost">
      <view class="nav-icon">💬</view>
      <text class="nav-text">球友社区</text>
    </view>
  </view>

  <!-- 热销推荐 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">🔥 热销推荐</text>
      <text class="section-more" bindtap="goMoreHot">更多 ></text>
    </view>
  </view>

  <view wx:if="{{hotList.length > 0}}" class="hot-grid">
    <view class="hot-card" wx:for="{{hotList}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <image class="hot-img" src="{{item.mainImg}}" mode="aspectFill" lazy-load="true"></image>
      <view class="hot-info">
        <view class="hot-name ellipsis">{{item.name}}</view>
        <view class="hot-bottom">
          <text class="price"><text class="price-symbol">¥</text>{{item.platformPrice}}</text>
          <text class="hot-sales">已售{{item.sales}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{!loading && hotList.length === 0}}" class="empty-box">
    <view class="empty-text">暂无热销商品</view>
  </view>

  <!-- 品牌推荐 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">🏷️ 全部分类</text>
    </view>
  </view>

  <view class="category-list">
    <view class="cat-item card" wx:for="{{categoryList}}" wx:key="id" bindtap="goProductList" data-id="{{item.id}}" data-name="{{item.name}}">
      <view class="cat-icon theme-bg">{{index + 1}}</view>
      <view class="flex1">
        <view class="cat-name">{{item.name}}</view>
        <view class="cat-desc">点击查看该分类商品</view>
      </view>
      <text class="cat-arrow">></text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-more">加载中...</view>
</view>
