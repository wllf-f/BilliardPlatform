.home {
  padding-bottom: 30rpx;
}

.search-bar {
  padding: 20rpx 24rpx;
  background: #1a6b3c;
}

.search-input {
  background: #fff;
  border-radius: 40rpx;
  padding: 16rpx 30rpx;
  display: flex;
  align-items: center;
}

.search-icon {
  margin-right: 16rpx;
  font-size: 28rpx;
}

.search-placeholder {
  color: #999;
  font-size: 28rpx;
}

.nav-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 30rpx 10rpx;
}

.nav-item {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}

.nav-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #e8f5ee;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-bottom: 12rpx;
}

.nav-text {
  font-size: 24rpx;
  color: #555;
}

.section {
  padding: 20rpx 24rpx 10rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-more {
  font-size: 24rpx;
  color: #999;
}

.hot-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 16rpx;
}

.hot-card {
  width: calc(50% - 20rpx);
  background: #fff;
  border-radius: 16rpx;
  margin: 10rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.hot-img {
  width: 100%;
  height: 280rpx;
  background: #f5f5f5;
}

.hot-info {
  padding: 16rpx 20rpx;
}

.hot-name {
  font-size: 26rpx;
  color: #333;
  height: 40rpx;
}

.hot-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 10rpx;
}

.hot-sales {
  font-size: 22rpx;
  color: #999;
}

.category-list {
  padding: 0 6rpx;
}

.cat-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
}

.cat-icon {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: bold;
  margin-right: 24rpx;
}

.cat-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.cat-desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

.cat-arrow {
  color: #ccc;
  font-size: 32rpx;
}
