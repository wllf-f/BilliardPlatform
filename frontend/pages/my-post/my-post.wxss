.my-post-page {
  padding: 16rpx 24rpx;
}

.post-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.post-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.post-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.status-tag {
  font-size: 20rpx;
  color: #999;
  background: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.status-pending {
  color: #f39c12;
  background: rgba(243, 156, 18, 0.1);
}

.status-rejected {
  color: #e74c3c;
  background: rgba(231, 76, 60, 0.1);
}

.post-images {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.post-img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 8rpx;
  margin: 0 8rpx 8rpx 0;
  background: #f5f5f5;
}

.post-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
}

.post-time {
  font-size: 22rpx;
  color: #999;
}

.post-stats {
  display: flex;
}

.stat {
  font-size: 22rpx;
  color: #999;
  margin-left: 24rpx;
}

.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1a6b3c, #2d8f5a);
  color: #fff;
  font-size: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(26, 107, 60, 0.4);
  z-index: 50;
}
