<view class="my-post-page">
  <view class="post-list">
    <view class="post-card" wx:for="{{list}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="post-header">
        <view class="post-title ellipsis">{{item.title}}</view>
        <!-- 帖子状态标签 -->
        <view wx:if="{{item.status === 3}}" class="status-tag">仅自己可见</view>
        <view wx:elif="{{item.status === 0}}" class="status-tag status-pending">待审核</view>
        <view wx:elif="{{item.status === 2}}" class="status-tag status-rejected">已驳回</view>
      </view>
      <view wx:if="{{item.imgList.length > 0}}" class="post-images">
        <image wx:for="{{item.imgList}}" wx:for-item="img" wx:key="*this" class="post-img" src="{{img}}" mode="aspectFill" lazy-load="true"></image>
      </view>
      <view class="post-footer">
        <text class="post-time">{{item.createTime}}</text>
        <view class="post-stats">
          <text class="stat">👁 {{item.viewCount}}</text>
          <text class="stat">❤️ {{item.likeCount}}</text>
          <text class="stat">💬 {{item.commentCount}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{!loading && list.length === 0}}" class="empty-box">
    <view class="empty-text">您还没有发布过帖子</view>
  </view>

  <view wx:if="{{loading}}" class="loading-more">加载中...</view>
  <view wx:if="{{!loading && list.length > 0 && noMore}}" class="no-more">— 没有更多了 —</view>

  <view style="height: 140rpx;"></view>

  <view class="fab-btn" bindtap="goCreate">+</view>
</view>
