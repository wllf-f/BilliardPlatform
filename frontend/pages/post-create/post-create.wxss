.post-create-page {
  padding-bottom: 20rpx;
}

.title-input {
  height: 80rpx;
  font-size: 34rpx;
  font-weight: bold;
}

.content-input {
  width: 100%;
  min-height: 300rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.divider {
  height: 1rpx;
  background: #f0f0f0;
  margin: 16rpx 0;
}

.img-section-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.img-grid {
  display: flex;
  flex-wrap: wrap;
}

.img-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin: 0 16rpx 16rpx 0;
}

.preview-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.del-btn {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  border-radius: 50%;
  font-size: 28rpx;
}

.add-img-btn {
  width: 200rpx;
  height: 200rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #ddd;
}

.add-icon {
  font-size: 60rpx;
  color: #ccc;
}

.add-text {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 24rpx;
  background: #fff;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
}

.submit-btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #1a6b3c, #2d8f5a);
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
}

.submit-btn.disabled {
  background: #ccc;
}
