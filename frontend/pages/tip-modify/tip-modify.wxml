<view class="tip-modify-page">
  <view class="banner-card">
    <view class="banner-title">🔧 皮头改装服务</view>
    <view class="banner-desc">专业更换皮头，提升击球手感</view>
  </view>

  <view class="section card">
    <view class="section-title">选择改装方式</view>

    <!-- 自备皮头 -->
    <view class="option-card {{option === 'own' ? 'active' : ''}}" bindtap="selectOption" data-option="own">
      <view class="option-radio">{{option === 'own' ? '●' : '○'}}</view>
      <view class="option-info">
        <view class="option-name">自备皮头更换</view>
        <view class="option-desc">您自行提供皮头，我们提供更换服务</view>
        <view class="option-price">服务费 ¥{{tipModifyFee}} + 运费 ¥{{tipModifyHandfee}}</view>
      </view>
    </view>

    <!-- 购买平台皮头 -->
    <view class="option-card {{option === 'buy' ? 'active' : ''}}" bindtap="selectOption" data-option="buy">
      <view class="option-radio">{{option === 'buy' ? '●' : '○'}}</view>
      <view class="option-info">
        <view class="option-name">购买平台皮头更换</view>
        <view class="option-desc">从平台选购皮头，含手工费</view>
        <view class="option-price">皮头价格 + 运费 ¥{{tipModifyHandfee}}</view>
      </view>
    </view>
  </view>

  <!-- 自备皮头：填写备注 -->
  <view class="section card" wx:if="{{option === 'own'}}">
    <view class="section-title">服务说明</view>
    <view class="service-info">
      <view class="info-line">服务费：¥{{tipModifyFee}}</view>
      <view class="info-line">运费：¥{{tipModifyHandfee}}</view>
      <view class="info-line">合计：¥{{ownTotal}}</view>
    </view>
    <view class="form-row textarea-row">
      <text class="form-label">备注说明</text>
      <textarea class="form-textarea" placeholder="请填写皮头规格、邮寄方式等备注信息" value="{{remark}}" bindinput="onRemarkInput" />
    </view>
    <view class="addr-tip">收件地址将在下一步填写</view>
  </view>

  <!-- 购买平台皮头：选择皮头商品 -->
  <view class="section card" wx:if="{{option === 'buy'}}">
    <view class="section-title">选择皮头商品</view>
    <view wx:if="{{!selectedProduct}}" class="select-btn" bindtap="selectProduct">点击选择皮头商品</view>
    <view wx:if="{{selectedProduct}}" class="selected-product">
      <image class="product-img" src="{{selectedProduct.mainImg}}" mode="aspectFill"></image>
      <view class="product-info">
        <view class="product-name ellipsis-2">{{selectedProduct.name}}</view>
        <view class="product-price">¥{{selectedProduct.platformPrice}} + 运费 ¥{{tipModifyHandfee}}</view>
      </view>
      <view class="change-btn" bindtap="selectProduct">更换</view>
    </view>
    <view class="form-row textarea-row" wx:if="{{selectedProduct}}">
      <text class="form-label">备注说明</text>
      <textarea class="form-textarea" placeholder="备注信息" value="{{remark}}" bindinput="onRemarkInput" />
    </view>
    <view class="addr-tip" wx:if="{{selectedProduct}}">收件地址将在下一步填写</view>
  </view>

  <view class="config-tip card">
    <view class="tip-line">改装地址：{{config.tipModifyAddress || '-'}}</view>
    <view class="tip-line">客服：{{config.customerService || '-'}}</view>
  </view>

  <view style="height: 140rpx;"></view>

  <!-- 底部操作 -->
  <view class="bottom-bar">
    <view class="bar-submit" bindtap="confirmTipModify">
      确认改装 ¥{{totalPrice}}
    </view>
  </view>
</view>
