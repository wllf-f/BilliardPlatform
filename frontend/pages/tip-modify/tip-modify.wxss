.tip-modify-page {
  padding-bottom: 30rpx;
}

.banner-card {
  background: linear-gradient(135deg, #1a6b3c, #2d8f5a);
  padding: 50rpx 40rpx;
  color: #fff;
}

.banner-title {
  font-size: 40rpx;
  font-weight: bold;
}

.banner-desc {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 12rpx;
}

.section {
  margin: 20rpx 24rpx;
  padding: 30rpx 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1a6b3c;
  margin-bottom: 24rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #1a6b3c;
}

.option-card {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  border: 2rpx solid #eee;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.option-card.active {
  border-color: #1a6b3c;
  background: #f5fbf7;
}

.option-radio {
  font-size: 36rpx;
  color: #1a6b3c;
  margin-right: 20rpx;
  margin-top: 4rpx;
}

.option-info {
  flex: 1;
}

.option-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.option-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.option-price {
  font-size: 26rpx;
  color: #e4393c;
  margin-top: 12rpx;
  font-weight: 500;
}

.service-info {
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.info-line {
  font-size: 28rpx;
  color: #555;
  line-height: 2;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.textarea-row {
  flex-direction: column;
  align-items: flex-start;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.form-textarea {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.addr-tip {
  font-size: 24rpx;
  color: #1a6b3c;
  margin-top: 16rpx;
}

.select-btn {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 30rpx;
  text-align: center;
  font-size: 28rpx;
  color: #1a6b3c;
}

.selected-product {
  display: flex;
  align-items: center;
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 20rpx;
}

.product-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}

.product-info {
  flex: 1;
}

.product-name {
  font-size: 26rpx;
  color: #333;
}

.product-price {
  font-size: 26rpx;
  color: #e4393c;
  margin-top: 10rpx;
  font-weight: 500;
}

.change-btn {
  background: #fff;
  color: #1a6b3c;
  border: 2rpx solid #1a6b3c;
  border-radius: 30rpx;
  padding: 10rpx 24rpx;
  font-size: 24rpx;
}

.config-tip {
  margin: 20rpx 24rpx;
  padding: 24rpx;
}

.tip-line {
  font-size: 24rpx;
  color: #999;
  line-height: 2;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
}

.bar-submit {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #1a6b3c, #2d8f5a);
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
}
