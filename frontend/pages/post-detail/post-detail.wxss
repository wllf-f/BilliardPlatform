.post-detail-page {
  padding-bottom: 20rpx;
}

.post-card {
  padding: 30rpx 24rpx;
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  position: relative;
}

.header-actions {
  display: flex;
  gap: 12rpx;
  margin-left: auto;
}

.header-btn {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.header-btn.btn-toggle {
  background: #1a6b3c;
  color: white;
}

.header-btn.btn-delete {
  background: rgba(244, 67, 54, 0.1);
  color: #f44336;
}

.post-status {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

.status-hidden {
  background: rgba(255, 193, 7, 0.1);
  color: #ff9800;
}

.status-public {
  background: rgba(76, 175, 80, 0.1);
  color: #4caf50;
}

.status-pending {
  background: rgba(158, 158, 158, 0.1);
  color: #9e9e9e;
}

.status-rejected {
  background: rgba(244, 67, 54, 0.1);
  color: #f44336;
}

.reject-reason {
  background: rgba(244, 67, 54, 0.05);
  border: 1rpx solid rgba(244, 67, 54, 0.2);
  border-radius: 8rpx;
  padding: 16rpx;
  margin-bottom: 20rpx;
}

.reject-label {
  font-size: 24rpx;
  color: #f44336;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.reject-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.avatar {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  background: #f5f5f5;
  margin-right: 20rpx;
}

.user-info {
  flex: 1;
}

.nick-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.create-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.post-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  line-height: 1.4;
}

.post-content {
  font-size: 30rpx;
  color: #444;
  line-height: 1.8;
  margin-bottom: 20rpx;
}

.post-images {
  display: flex;
  flex-direction: column;
}

.post-img {
  width: 100%;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}

.post-stats {
  display: flex;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
  margin-top: 20rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  margin-right: 50rpx;
  font-size: 26rpx;
  color: #666;
}

.stat-item:active {
  opacity: 0.6;
}

.stat-icon {
  margin-right: 10rpx;
  font-size: 32rpx;
}

.comment-section {
  padding: 30rpx 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.comment-list {
  margin-top: 10rpx;
}

.comment-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f5f5f5;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.comment-body {
  flex: 1;
  min-width: 0;
}

.comment-name {
  font-size: 26rpx;
  color: #1a6b3c;
  font-weight: 500;
}

.comment-text {
  font-size: 28rpx;
  color: #333;
  margin: 8rpx 0;
  line-height: 1.5;
}

.comment-time {
  font-size: 22rpx;
  color: #999;
}

.empty-comment {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 40rpx 0;
}

.bottom-input {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  background: #fff;
  padding: 16rpx 24rpx;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
}

.comment-input {
  flex: 1;
  background: #f5f5f5;
  border-radius: 32rpx;
  padding: 16rpx 28rpx;
  font-size: 28rpx;
}

.send-btn {
  margin-left: 20rpx;
  background: #1a6b3c;
  color: #fff;
  border-radius: 32rpx;
  padding: 12rpx 32rpx;
  font-size: 28rpx;
}
