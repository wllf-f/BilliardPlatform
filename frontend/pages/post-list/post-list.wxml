<view class="post-list-page">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <input class="search-input" placeholder="搜索帖子" value="{{keyword}}" bindinput="onSearchInput" bindconfirm="doSearch" confirm-type="search" />
    <view class="search-btn theme-color" bindtap="doSearch">搜索</view>
  </view>

  <!-- 帖子列表 -->
  <view class="post-list">
    <view class="post-card" wx:for="{{list}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="post-header">
        <image class="avatar" src="{{item.avatar || '/images/default-avatar.png'}}" mode="aspectFill"></image>
        <view class="user-info">
          <view class="nick-name">{{item.nickName}}</view>
          <view class="create-time">{{item.createTime}}</view>
        </view>
      </view>
      <view class="post-title ellipsis">{{item.title}}</view>
      <view wx:if="{{item.images}}" class="post-images">
        <image wx:for="{{item.imgList}}" wx:for-item="img" wx:key="*this" class="post-img" src="{{img}}" mode="aspectFill" lazy-load="true"></image>
      </view>
      <view class="post-footer">
        <view class="footer-item">
          <text class="footer-icon">👁</text>
          <text>{{item.viewCount}}</text>
        </view>
        <view class="footer-item" catchtap="toggleLike" data-id="{{item.id}}" data-index="{{index}}">
          <text class="footer-icon {{item.liked ? 'liked-heart' : ''}}">{{item.liked ? '❤️' : '🤍'}}</text>
          <text>{{item.likeCount}}</text>
        </view>
        <view class="footer-item">
          <text class="footer-icon">💬</text>
          <text>{{item.commentCount}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{!loading && list.length === 0}}" class="empty-box">
    <view class="empty-text">暂无帖子，快来发布第一条吧</view>
  </view>

  <view wx:if="{{loading}}" class="loading-more">加载中...</view>
  <view wx:if="{{!loading && list.length > 0 && noMore}}" class="no-more">— 没有更多了 —</view>

  <view style="height: 140rpx;"></view>

  <!-- 发布按钮 -->
  <view class="fab-btn" bindtap="goCreate">+</view>
</view>
