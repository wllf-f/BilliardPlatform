/* app.wxss 全局样式 */
page {
  background-color: #f5f6f8;
  color: #333;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

/* 主题色 */
.theme-color {
  color: #1a6b3c;
}

.theme-bg {
  background-color: #1a6b3c;
}

/* 卡片 */
.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

/* 按钮 */
.btn-primary {
  background: linear-gradient(135deg, #1a6b3c, #2d8f5a);
  color: #fff;
  border-radius: 48rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-primary[disabled] {
  background: #cccccc;
  color: #fff;
}

.btn-outline {
  background: #fff;
  color: #1a6b3c;
  border: 2rpx solid #1a6b3c;
  border-radius: 48rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 30rpx;
}

/* 价格 */
.price {
  color: #e4393c;
  font-weight: bold;
}

.price-symbol {
  font-size: 24rpx;
}

/* 空状态 */
.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-box .empty-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 24rpx;
  opacity: 0.4;
}

.empty-box .empty-text {
  color: #999;
  font-size: 28rpx;
}

/* 加载更多 */
.loading-more {
  text-align: center;
  padding: 24rpx;
  color: #999;
  font-size: 26rpx;
}

.no-more {
  text-align: center;
  padding: 24rpx;
  color: #bbb;
  font-size: 24rpx;
}

/* 通用 flex */
.flex {
  display: flex;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex1 {
  flex: 1;
  min-width: 0;
}

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ellipsis-2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  margin-right: 10rpx;
}

.tag-green {
  background: #e8f5ee;
  color: #1a6b3c;
}

.tag-orange {
  background: #fff3e0;
  color: #ff9800;
}

.tag-red {
  background: #ffebee;
  color: #e4393c;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: #eee;
  margin: 20rpx 0;
}

/* 输入框 */
.input-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.input-row .label {
  width: 180rpx;
  color: #666;
  font-size: 28rpx;
}

.input-row .input {
  flex: 1;
  height: 60rpx;
  font-size: 28rpx;
}
